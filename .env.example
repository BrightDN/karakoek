# App
PORT=8080
BASE_URL=http://localhost:8080
COOKIE_SECURE=false            # true when served over HTTPS (default true)
TRUST_PROXY=false              # true to use X-Forwarded-For for login rate limiting

# Admin (single account). Prefer a bcrypt hash: ./karakoek --hash-password 'secret'
ADMIN_USERNAME=host
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=change-me     # convenience alternative, hashed in memory at startup

# Cookie keys: generate with  openssl rand -base64 64  /  openssl rand -base64 32
SESSION_HASH_KEY=
SESSION_BLOCK_KEY=

# Table codes: code:tableNumber, comma separated (generate: ./karakoek --gen-codes 20)
TABLE_CODES=k7Qx2p:1,Zm4Rt9:2,b8NwYc:3

# Database
POSTGRES_USER=karakoek
POSTGRES_PASSWORD=change-me
POSTGRES_DB=karakoek
DATABASE_URL=postgres://karakoek:change-me@db:5432/karakoek?sslmode=disable
